{
  "expo": {
    "name": "Docklands Accountants",
    "slug": "docklands-accountants",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/docklands_logo.png",
    "scheme": "docklands-accountants",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.docklandsaccountants.app",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.docklandsaccountants.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/docklands_logo.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "versionCode": 8
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/docklands_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/docklands_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them in chat."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow app to access your microphone for voice messages."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "134fa15c-7f4a-4168-ae7e-c07f3148eff1"
      }
    },
    "owner": "asif_iqbal_dev"
  }
}
